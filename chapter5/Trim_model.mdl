      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function y = fcn(u)
    y = zeros(3,1);
    y(1) = -sin(u(2));
    y(2) = cos(u(2)) * sin(u(1));
    y(3) = cos(u(2)) * cos(u(1));
end
</P>
      </eml>
    </state>
    <data SSID="4" name="u">
